    {
      "parameters": {
        "jsCode": "const members = $('Get row(s) in sheet').all();\nconst cptRules = $('Get row(s) in sheet1').all();\nconst parsed = $('Code in JavaScript1').first().json;\n\nconst memberId = parsed.memberId;\nconst cptCode = parsed.cptCode;\nconst phone = String(parsed.phone || 'unknown');\n\nconst member = members.find(m => m.json.MemberID === memberId);\nconst cptRule = cptRules.find(c => String(c.json.CPT) === String(cptCode));\n\nlet decision;\nif (!member) {\n  decision = `❌ Member ${memberId} not found. Please verify the Member ID.`;\n} else if (member.json.CoverageStatus !== 'Active') {\n  decision = `⚠️ Member ${memberId} (${member.json.MemberName}) coverage is ${member.json.CoverageStatus}. Claim will be denied.`;\n} else if (!cptRule) {\n  decision = `⚠️ CPT code ${cptCode} not found in rules. Please verify the CPT code.`;\n} else if (cptRule.json.PriorAuthRequired === 'Yes') {\n  decision = `⚠️ Prior Authorization REQUIRED\\nMember: ${member.json.MemberName} (${memberId}) - ${member.json.CoverageStatus}\\nCPT: ${cptCode} requires prior auth before service.\\nAction: Submit prior auth request before scheduling.`;\n} else {\n  decision = `✅ Eligible - No Prior Auth Required\\nMember: ${member.json.MemberName} (${memberId}) - ${member.json.CoverageStatus}\\nCPT: ${cptCode} - cleared for billing.\\nProceed with scheduling.`;\n}\n\nreturn [{ json: { decision, memberId, cptCode, phone, timestamp: new Date().toISOString() } }];"
      },
