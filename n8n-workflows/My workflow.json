        "jsCode": "const body = $input.first().json.body;\nconst message = body.message;\nconst phone = body.phone;\n\nconst match = message.match(/CHECK\\s+(\\S+)\\s+(\\S+)/i);\nif (!match) {\n  return [{ json: { valid: false, error: \"Invalid format\", phone: phone } }];\n}\nreturn [{ json: { valid: true, memberId: match[1], cptCode: match[2], phone: phone } }];"
